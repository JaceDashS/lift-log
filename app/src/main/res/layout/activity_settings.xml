<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/lift_gutter">

        <TextView
            style="@style/LiftText.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title" />

        <LinearLayout
            style="@style/LiftCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lift_gap_lg"
            android:orientation="vertical">

            <TextView
                style="@style/LiftText.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_exercises" />

            <TextView
                android:id="@+id/text_settings_exercises"
                style="@style/LiftText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lift_gap_sm" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_settings_add_exercise"
                style="@style/LiftButton.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lift_gap_sm"
                android:text="@string/add_exercise" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_settings_layout"
            style="@style/LiftButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lift_gap_md"
            android:text="@string/home_layout" />

        <LinearLayout
            style="@style/LiftCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lift_gap_md"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_button_opacity"
                style="@style/LiftText.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/slider_button_opacity" />

            <SeekBar
                android:id="@+id/slider_button_opacity"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:min="35"
                android:max="90" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_lift_input"
                android:gravity="center"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="horizontal"
                android:padding="@dimen/lift_gap_xs">

                <TextView
                    android:id="@+id/preview_timer_opacity"
                    style="@style/LiftText.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/lift_gap_md"
                    android:text="0:00" />

                <TextView
                    android:id="@+id/preview_button_opacity"
                    style="@style/LiftText.OverlayCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:paddingHorizontal="@dimen/lift_gap_md"
                    android:text="@string/start_set" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_settings_about"
            style="@style/LiftButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lift_gap_md"
            android:text="@string/settings_about" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_settings_feedback"
            style="@style/LiftButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lift_gap_sm"
            android:text="@string/settings_feedback" />

        <TextView
            style="@style/LiftText.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lift_gap_lg"
            android:gravity="center"
            android:text="@string/lift_preview_notice" />
    </LinearLayout>
</ScrollView>
