<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/lift_compare_row_height"
    android:paddingTop="@dimen/lift_gap_sm"
    android:paddingBottom="@dimen/lift_gap_sm"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/text_compare_set"
        style="@style/LiftText.Title"
        android:layout_width="@dimen/lift_row_height"
        android:layout_height="wrap_content"
        android:textColor="@color/lift_acid" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_compare_reps"
            style="@style/LiftText.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum" />

        <TextView
            android:id="@+id/text_compare_reps_prev"
            style="@style/LiftText.Note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum" />

        <TextView
            android:id="@+id/text_compare_reps_delta"
            style="@style/LiftText.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical|end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_compare_rest"
            style="@style/LiftText.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum" />

        <TextView
            android:id="@+id/text_compare_rest_prev"
            style="@style/LiftText.Note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/text_compare_rest_delta"
            style="@style/LiftText.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum" />
    </LinearLayout>
</LinearLayout>
