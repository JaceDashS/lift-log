<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/LiftCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/lift_gap_sm"
    android:background="@drawable/bg_lift_card_pressable"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_exercise_name"
            style="@style/LiftText.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/text_exercise_meta"
            style="@style/LiftText.Note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lift_gap_xs" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_exercise_avg"
            style="@style/LiftText.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/lift_acid" />

        <TextView
            style="@style/LiftText.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/records_avg_reps" />
    </LinearLayout>
</LinearLayout>
