<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/ui_spacing_lg">

    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/ui_size_zero"
        android:layout_weight="1" />

    <Button
        android:id="@+id/button_start_workout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ui_size_zero"
        android:layout_weight="2"
        android:minHeight="@dimen/ui_main_start_button_min_height"
        android:text="@string/start_workout"
        android:textSize="@dimen/ui_main_start_button_text_size" />

    <Button
        android:id="@+id/button_dev_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_main_button_spacing"
        android:text="@string/dev_mode" />

    <Button
        android:id="@+id/button_reset_all_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_main_button_spacing"
        android:text="@string/reset_all_settings" />

    <Button
        android:id="@+id/button_clear_log"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_main_button_spacing"
        android:text="@string/clear_log" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/ui_size_zero"
        android:layout_weight="1" />

</LinearLayout>

