<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content_exercise_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/lift_gutter">

        <TextView
            style="@style/LiftText.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/detail_label" />

        <TextView
            android:id="@+id/text_detail_name"
            style="@style/LiftText.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/lift_text_display" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lift_gap_md"
            android:orientation="horizontal">

            <LinearLayout
                style="@style/LiftCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/lift_gap_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/LiftText.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_last_done" />

                <TextView
                    android:id="@+id/text_detail_last"
                    style="@style/LiftText.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lift_gap_xs" />
            </LinearLayout>

            <LinearLayout
                style="@style/LiftCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/lift_gap_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/LiftText.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/records_avg_reps" />

                <TextView
                    android:id="@+id/text_detail_avg"
                    style="@style/LiftText.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lift_gap_xs"
                    android:textColor="@color/lift_acid" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/LiftCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lift_gap_md"
            android:orientation="vertical">

            <TextView
                style="@style/LiftText.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trend_title" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_trend_spacing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lift_gap_md"
                app:checkedButton="@id/button_trend_per_session"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_trend_per_session"
                    style="@style/LiftButton.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/trend_per_session" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_trend_per_day"
                    style="@style/LiftButton.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/trend_per_day" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.example.workouttimer.ui.TrendChartView
                android:id="@+id/chart_trend"
                android:layout_width="match_parent"
                android:layout_height="@dimen/lift_chart_height"
                android:layout_marginTop="@dimen/lift_gap_md" />
        </LinearLayout>

        <LinearLayout
            style="@style/LiftCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lift_gap_md"
            android:orientation="vertical">

            <TextView
                style="@style/LiftText.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/compare_title" />

            <TextView
                android:id="@+id/text_compare_sessions"
                style="@style/LiftText.Note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lift_gap_xs" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lift_gap_md"
                android:orientation="horizontal">

                <TextView
                    style="@style/LiftText.Label"
                    android:layout_width="@dimen/lift_row_height"
                    android:layout_height="wrap_content"
                    android:text="@string/compare_col_set" />

                <TextView
                    style="@style/LiftText.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/compare_col_reps" />

                <TextView
                    style="@style/LiftText.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="@string/compare_col_rest" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/list_compare_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
