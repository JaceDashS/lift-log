<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/lift_gutter">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/LiftText.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/session_title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_session_end"
                style="@style/LiftButton.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/session_end" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_session_state"
            style="@style/LiftText.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/lift_gap_md" />

        <TextView
            android:id="@+id/text_session_timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textSize="@dimen/lift_text_timer"
            android:textStyle="bold|italic" />

        <TextView
            android:id="@+id/text_session_caption"
            style="@style/LiftText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/lift_text_dim" />

        <TextView
            android:id="@+id/text_session_set"
            style="@style/LiftText.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lift_gap_xs"
            android:gravity="center" />

        <LinearLayout
            style="@style/LiftCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lift_gap_lg"
            android:orientation="vertical">

            <TextView
                style="@style/LiftText.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/session_input_title" />

            <TextView
                style="@style/LiftText.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lift_gap_md"
                android:text="@string/session_exercise" />

            <EditText
                android:id="@+id/input_session_exercise"
                style="@style/LiftInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lift_gap_xs"
                android:hint="@string/session_exercise_hint"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lift_gap_md"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/lift_gap_sm"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/LiftText.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/session_weight" />

                    <EditText
                        android:id="@+id/input_session_weight"
                        style="@style/LiftInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lift_gap_xs"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal" />

                    <TextView
                        style="@style/LiftText.Note"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lift_gap_xs"
                        android:text="@string/session_weight_note" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/lift_gap_sm"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/LiftText.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/session_reps" />

                    <EditText
                        android:id="@+id/input_session_reps"
                        style="@style/LiftInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lift_gap_xs"
                        android:importantForAutofill="no"
                        android:inputType="number" />

                    <TextView
                        style="@style/LiftText.Note"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lift_gap_xs"
                        android:text="@string/session_reps_note" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lift_gap_md"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_session_push"
                style="@style/LiftButton.Secondary"
                android:layout_width="0dp"
                android:layout_height="@dimen/lift_action_height"
                android:layout_marginEnd="@dimen/lift_gap_sm"
                android:layout_weight="1"
                android:text="@string/session_button_push"
                android:textSize="@dimen/lift_text_headline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_session_rest"
                style="@style/LiftButton.Primary"
                android:layout_width="0dp"
                android:layout_height="@dimen/lift_action_height"
                android:layout_marginStart="@dimen/lift_gap_sm"
                android:layout_weight="1"
                android:text="@string/session_button_rest"
                android:textSize="@dimen/lift_text_headline" />
        </LinearLayout>

        <TextView
            style="@style/LiftText.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lift_gap_xl"
            android:text="@string/session_log_title" />

        <LinearLayout
            android:id="@+id/list_session_sets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lift_gap_sm"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
